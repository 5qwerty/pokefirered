const LT = 2
const FERRY_GUY = 1

mapscripts VermilionCity_MapScripts {
	MAP_SCRIPT_ON_TRANSITION {
		setworldmapflag(FLAG_WORLD_MAP_VERMILION_CITY)
	}
}

script VermilionCity_EventScript_Sergei {
	lock
	faceplayer
	goto_if_eq(VAR_MAP_SCENE_VERMILION_CITY, 1, Vermilion_EventScript_SergeiGave)
	goto_if_eq(VAR_MAP_SCENE_VERMILION_CITY, 2, Vermilion_EventScript_SergeiReceive)
	goto_if_ge(VAR_MAP_SCENE_VERMILION_CITY, 3, Vermilion_EventScript_SergeiFixing)
	msgbox(VermilionCity_Text_SergeiIntro, MSGBOX_NPC)
	giveitem_msg(VermilionCity_Text_SSTicket, ITEM_SS_TICKET, 1, MUS_OBTAIN_KEY_ITEM)
	msgbox(VermilionCity_Text_SergeiBye, MSGBOX_NPC)
	addvar(VAR_MAP_SCENE_VERMILION_CITY, 1) //Should be 1 after this
	release
	end
}

script Vermilion_EventScript_SergeiGave {
	msgbox(VermilionCity_Text_SergeiBye, MSGBOX_NPC)
	release
	end
}

script Vermilion_EventScript_SergeiReceive {
	msgbox(VermilionCity_Text_SergeiReceive, MSGBOX_NPC)
	msgbox(VermilionCity_Text_PlayerGives)
	playfanfare(MUS_OBTAIN_ITEM)
	waitfanfare
	closemessage
	msgbox(VermilionCity_Text_SergeiFix, MSGBOX_NPC)
	applymovement(LT, VermilionCity_Movement_SergeiFix)
	waitmovement(0)
	release
	end
}

script Vermilion_EventScript_SergeiFixing {
	msgbox(VermilionCity_Text_MustWait, MSGBOX_NPC)
	applymovement(LT, Common_Movement_FaceUp)
	waitmovement(0)
	release
	end
}

text VermilionCity_Text_SergeiIntro {
	format("???: Good day, comrade!\nAh, you are {PLAYER}!\pI hear much from PROF. SOAK about\nyou.\pMe? My name SERGEI, I used to be\nCOMRADE in old country.\pAs you see, my GYM wall is not so\ngood, it needs the fix.\pCan you do me favour and take S.S.\nTICKET and go CINNABAR ISLAND to\lpick up material?")
}

text VermilionCity_Text_SSTicket {
	format("{PLAYER} received the S.S. TICKET\nfrom CDE SERGEI!")
}

text VermilionCity_Text_SergeiBye {
	format("SERGEI: OK! You go now!\nI stay here to watch over GYM.")
}

text VermilionCity_Text_SergeiReceive {
	format("SERGEI: Ah! {PLAYER}!\nYou have returned with material?")
}

text VermilionCity_Text_PlayerGives {
	format("{PLAYER} gave the PARCEL to\nCDE SERGEI.")
}

text VermilionCity_Text_SergeiFix {
	format("SERGEI: Much thanks, comrade.\nI am go to fix wall now.")
}

text VermilionCity_Text_MustWait {
	format("SERGEI: Be patient, my friend.\nFixing wall take time.")
}

movement VermilionCity_Movement_SergeiFix {
	walk_right * 2
	walk_up
}

script VermilionCity_EventScript_CheckTicket {
	lockall
	textcolor(NPC_TEXT_COLOR_MALE)
	applymovement (FERRY_GUY, Common_Movement_WalkInPlaceFasterLeft)
	applymovement (OBJ_EVENT_ID_PLAYER, Common_Movement_WalkInPlaceFasterRight)
	waitmovement (0)
	msgbox(VermilionCity_Text_DoYouHaveATicket)
	goto_if_eq(VAR_MAP_SCENE_SS_ANNE_STATE, 0, VermilionCity_EventScript_SSAnneHere) //SS Anne is at Vermilion, otherwise at Cinnabar
	msgbox(VermilionCity_Text_SSAnneNotHere)
	closemessage
	releaseall
	end
}

script VermilionCity_EventScript_ExitedTicketCheck {
	lockall
	setvar(VAR_VERMILION_CITY_TICKET_CHECK_TRIGGER, 0)
	releaseall
	end
}
	

script VermilionCity_EventScript_SSAnneHere {
	checkitem(ITEM_SS_TICKET)
	goto_if_eq(VAR_RESULT, FALSE, VermilionCity_EventScript_DontHaveSSTicket)
	//goto_if_unset(FLAG_GOT_SS_TICKET, VermilionCity_EventScript_DontHaveSSTicket)
	msgbox(VermilionCity_Text_FlashedSSTicket)
	textcolor(NPC_TEXT_COLOR_MALE)
	msgbox(VermilionCity_Text_FlashedSSTicket2)
	setvar(VAR_VERMILION_CITY_TICKET_CHECK_TRIGGER, 1)
	releaseall
}

script VermilionCity_EventScript_DontHaveSSTicket {
	textcolor(NPC_TEXT_COLOR_NEUTRAL)
	msgbox(VermilionCity_Text_DontHaveNeededSSTicket)
	textcolor(NPC_TEXT_COLOR_MALE)
	msgbox(VermilionCity_Text_DontHaveNeededSSTicket2)
	goto(VermilionCity_EventScript_WalkUpPier)
	end
}

script VermilionCity_EventScript_WalkUpPier {
	closemessage
	applymovement(FERRY_GUY, Common_Movement_FaceOriginalDirection)
	applymovement(OBJ_EVENT_ID_PLAYER, Common_Movement_WalkUp)
	waitmovement(0)
	releaseall
	end
}
	
text VermilionCity_Text_SSAnneNotHere {
	format("Apologies, the S.S. ANNE ain't\nhere right now.")
}

script VermilionCity_EventScript_FerrySailor {
	lock
	faceplayer
	msgbox(VermilionCity_Text_WelcomeToTheSSAnne)
	release
	end 
}

script VermilionCity_EventScript_CitySign {
	msgbox(VermilionCity_Text_CitySign, MSGBOX_SIGN)
	clearflag(FLAG_HIDE_SS_ANNE)
	end
}
	

script VermilionCity_EventScript_PokemonFanClubSign {
	msgbox(VermilionCity_Text_PokemonFanClubSign, MSGBOX_SIGN)
	end
}
	
script VermilionCity_EventScript_GymSign {
	lockall
	//famechecker FAMECHECKER_LTSURGE, 0
	msgbox(VermilionCity_Text_GymSign)
	setflag(FLAG_HIDE_SS_ANNE)
	releaseall
	end
}
	
script VermilionCity_EventScript_HarborSign {
	msgbox(VermilionCity_Text_VermilionHarbor, MSGBOX_SIGN)
	end
}

text VermilionCity_Text_CitySign {
	"VERMILION CITY\n"
    "The Port of Exquisite Sunsets"
}
    
text VermilionCity_Text_PokemonFanClubSign {
	"POKéMON FAN CLUB\n"
    "All POKéMON fans welcome!"
}
    
text VermilionCity_Text_GymSign {
	"VERMILION CITY POKéMON GYM\n"
    "LEADER: SERGEI\l"
    "The Surging Comrade!"
}

text VermilionCity_Text_VermilionHarbor {
	"VERMILION HARBOR"	
}

text VermilionCity_Text_WelcomeToTheSSAnne {
	"Welcome to the S.S. ANNE!"
}

text VermilionCity_Text_DoYouHaveATicket {
	"Welcome to the S.S. ANNE!\p"
	"Excuse me, do you have a ticket?"
}

text VermilionCity_Text_FlashedSSTicket {
	"{PLAYER} flashed the S.S. TICKET!"
}

text VermilionCity_Text_FlashedSSTicket2 {
	"Great!\n"
    "Welcome to the S.S. ANNE!"
}

text VermilionCity_Text_DontHaveNeededSSTicket {
	"{PLAYER} doesn't have the needed\n"
    "S.S. TICKET."
}

text VermilionCity_Text_DontHaveNeededSSTicket2 {
	"Apologies!\p"
    "You need a ticket to get aboard."
}
